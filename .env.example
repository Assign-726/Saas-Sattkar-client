# ==============================================================================
# Django Restaurant Platform - Environment Configuration Template (.env.example)
# Copy this file to .env on your deployment/production server and set real values.
# Command: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DJANGO SETTINGS
# ------------------------------------------------------------------------------
# In production, generate a strong random secret key (e.g., using: python -c 'import secrets; print(secrets.token_urlsafe(50))')
DJANGO_SECRET_KEY=replace-with-a-very-long-and-secure-random-secret-key

# Set to False for production!
DJANGO_DEBUG=False

# Comma-separated list of host/domain names that this Django site can serve
# e.g.: yourdomain.com,api.yourdomain.com,127.0.0.1
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,127.0.0.1,192.168.1.6

# Localization & Timezone
TIME_ZONE=Asia/Kolkata
LANGUAGE_CODE=en-us


# ------------------------------------------------------------------------------
# 2. FRONTEND APPLICATION URL
# ------------------------------------------------------------------------------
# Used for QR code generation and redirect links
FRONTEND_URL=https://yourdomain.com


# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PostgreSQL Recommended)
# ------------------------------------------------------------------------------
# Option A: Granular Parameters
DB_ENGINE=django.db.backends.postgresql
DB_NAME=restaurant_db
DB_USER=restaurant_user
DB_PASSWORD=your_secure_db_password_here
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=600

# Option B: 12-factor DATABASE_URL format (Uncomment to use instead of granular params)
# DATABASE_URL=postgres://restaurant_user:your_secure_db_password_here@127.0.0.1:5432/restaurant_db


# ------------------------------------------------------------------------------
# 4. CORS & CSRF TRUSTED ORIGINS
# ------------------------------------------------------------------------------
# Explicitly allow your frontend domain to communicate with the backend
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,http://192.168.1.6:8000
CORS_ALLOW_CREDENTIALS=True

# Required for Django 4.0+ / 5.0+ to prevent 403 CSRF verification errors on POST requests
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,http://192.168.1.6:8000


# ------------------------------------------------------------------------------
# 5. STATIC & MEDIA ASSETS
# ------------------------------------------------------------------------------
STATIC_URL=/static/
MEDIA_URL=/media/
# STATIC_ROOT and MEDIA_ROOT default to 'staticfiles' and 'media' in the project directory


# ------------------------------------------------------------------------------
# 6. EMAIL NOTIFICATIONS & SMTP CONFIGURATION
# ------------------------------------------------------------------------------
# Production SMTP backend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=notifications@yourdomain.com
EMAIL_HOST_PASSWORD=your_smtp_app_password
DEFAULT_FROM_EMAIL="Restaurant Platform" <notifications@yourdomain.com>


# ------------------------------------------------------------------------------
# 7. PRODUCTION SECURITY & REVERSE PROXY HEADERS (when DJANGO_DEBUG=False)
# ------------------------------------------------------------------------------
# Set to True when your site has SSL/HTTPS certificates configured
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Reverse Proxy support (Nginx / Cloudflare / Traefik / AWS ALB)
# Tells Django to trust HTTP_X_FORWARDED_PROTO header for HTTPS detection
SECURE_PROXY_SSL_HEADER_ENABLED=True


# ------------------------------------------------------------------------------
# 8. JWT TOKEN LIFETIME SETTINGS (Optional)
# ------------------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_HOURS=1
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1


# ------------------------------------------------------------------------------
# 9. APPLICATION BRANDING & LICENSE LIMITS
# ------------------------------------------------------------------------------
APP_NAME=Hotel Management System
APP_NAME_PREFIX=Hotel Management
APP_NAME_SUFFIX=System
APP_TAGLINE=Sign in to access your administrative dashboard
APP_SUPPORT_URL=http://localhost:3000

# Limits
MAX_ALLOWED_BUSINESSES=1
# Maximum branch outlets per business (set 0 for unlimited)
MAX_ALLOWED_BRANCHES=3

# Regional defaults
DEFAULT_CURRENCY=₹
DEFAULT_STATE=Rajasthan


# ------------------------------------------------------------------------------
# 10. FEATURE FLAGS & MODULE TOGGLES
# ------------------------------------------------------------------------------
# Toggle Website Pages / Landing Page CMS across Super Admin and Customer Portal.
# Set to False to completely hide/disable Website CMS, Landing Pages & website controls.
SHOW_WEBSITE_PAGES=True


