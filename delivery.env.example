# ---------------------------------------------------------------------------------------
# Zomato / Swiggy — Sattkar-level defaults (copy what you need into .env)
#
# Use these when Sattkar (eCentra) is the registered POS partner and one set of
# credentials serves every restaurant. If each brand has its own credentials, leave
# these empty and enter them in the admin: Online Delivery → Zomato/Swiggy → Settings →
# Brand account. Resolution order: outlet override → brand account → these values.
# Everything entered in the admin is stored encrypted.
# ---------------------------------------------------------------------------------------

# Fernet key that encrypts all partner credentials in the database. Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it stable — changing it makes saved credentials unreadable.
DELIVERY_CREDENTIALS_KEY=

# Zomato POS Integration
ZOMATO_CLIENT_ID=
ZOMATO_CLIENT_SECRET=
ZOMATO_ACCESS_TOKEN=          # static token; leave empty when using client ID + secret
ZOMATO_WEBHOOK_SECRET=        # secret Zomato signs webhooks with (if they issue one)
ZOMATO_API_BASE_URL=          # from Zomato's partner documentation
ZOMATO_TOKEN_URL=             # OAuth token endpoint, when tokens come from client ID + secret
ZOMATO_AUTH_HEADER=Authorization
ZOMATO_SIGNATURE_HEADER=X-Signature
# Endpoint path per action; placeholders {order_id} {outlet_id} {item_id}
ZOMATO_API_PATHS={}

# Swiggy Integration
SWIGGY_CLIENT_ID=
SWIGGY_CLIENT_SECRET=
SWIGGY_ACCESS_TOKEN=
SWIGGY_WEBHOOK_SECRET=
SWIGGY_API_BASE_URL=
SWIGGY_TOKEN_URL=
SWIGGY_AUTH_HEADER=Authorization
SWIGGY_SIGNATURE_HEADER=X-Signature
SWIGGY_API_PATHS={}
